#!/bin/sh
# Install the blessed `lore` bin: a frozen artifact built from a CLEAN tree at
# the landed ref. Subagents and sessions use this by default; dev runs invoke
# `bun <checkout>/src/main.ts` by explicit absolute path instead. Gates on
# tests — a bad commit reaches nobody, a bad installed bin reaches every well.
#
# Usage: scripts/install [--compile]
#   default: single-file JS bundle (~KBs) + shim  -> ~/.bun/bin/lore
#   --compile: standalone executable (embeds Bun runtime, --bytecode startup)
set -e
cd "$(dirname "$0")/.."

if [ -n "$(git status --porcelain)" ]; then
  echo "refusing: dirty tree — the installed bin must be a reproducible, landed artifact" >&2
  exit 1
fi

bun install --frozen-lockfile >/dev/null

echo "gate: bun test" >&2
bun test >/dev/null 2>&1 || { bun test; exit 1; }

VERSION=$(bun -p 'require("./package.json").version')
BUILD=$(git rev-list --count HEAD)
SHA=$(git rev-parse --short HEAD)
INFO="v$VERSION b$BUILD @ $SHA"

mkdir -p "$HOME/.lore/dist" "$HOME/.bun/bin"

if [ "$1" = "--compile" ]; then
  bun build src/main.ts --compile --minify --bytecode \
    --define "LORE_BUILD_INFO=\"$INFO (compiled)\"" \
    --outfile "$HOME/.lore/dist/lore" >/dev/null
  ln -sf "$HOME/.lore/dist/lore" "$HOME/.bun/bin/lore"
  echo "installed: lore $INFO (compiled) -> ~/.bun/bin/lore"
else
  bun build src/main.ts --target=bun --minify \
    --define "LORE_BUILD_INFO=\"$INFO\"" \
    --outfile "$HOME/.lore/dist/lore.js" >/dev/null
  printf '#!/bin/sh\nexec bun "%s" "$@"\n' "$HOME/.lore/dist/lore.js" >"$HOME/.bun/bin/lore"
  chmod +x "$HOME/.bun/bin/lore"
  echo "installed: lore $INFO (bundle) -> ~/.bun/bin/lore"
fi
